{
  "schemaVersion": 1,
  "id": "rttt",
  "version": "1.1",
  "name": "Road Trip on TikTok",
  "description": "Игра для TikTok LIVE: Стив и Алекс едут по бесконечной дороге, а зрители помогают или мешают лайками, подарками и мобами из чата.",
  "authors": [
    "holod"
  ],
  "license": "All-Rights-Reserved",
  "icon": "assets/rttt/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "rttt.RTTT"
    ],
    "client": [
      "rttt.client.RTTTClient"
    ]
  },
  "mixins": [
    "rttt.mixins.json",
    {
      "config": "rttt.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": ">=26.3 <27",
    "java": ">=25",
    "fabric-api": "*"
  },
  "contact": {
    "homepage": "https://github.com/holodse-web/road-trip-on-tiktok",
    "sources": "https://github.com/holodse-web/road-trip-on-tiktok",
    "issues": "https://github.com/holodse-web/road-trip-on-tiktok/issues"
  }
}
